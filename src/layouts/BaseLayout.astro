<style>
    body {
        margin: 0;
    }
    header {
        background-color: #f9f6fc;
        padding: 10px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;

        h1 {
            margin: 0;
        }

        ul {
            list-style-type: none;
            display: flex;
            gap: 16px;
        }

        a {
            text-decoration: none;
            border-bottom: 1px dashed;
        }
    }
</style>

<style is:global>
    * {
        font-family: "Poppins", sans-serif;
        color: #333;
    }

    .content {
        width: 100%;
        max-height: 1200px;
        margin: 60px auto;
        padding: 0 20px;
        box-sizing: border-box;
    }

    h2 {
        font-size: 1.8em;
    }

    p {
        font-size: 1.2em;
    }

    .likes {
        border-top: 1px dashed rgb(135, 135, 215);
        background-color: #f9f6fc;
        margin-top: 40px;
        display: flex;
        padding: 10px;
        gap: 20px;
        align-items: center;
    }

    button {
        background-color: #c194ef;
        border: 0;
        color: #fff;
        padding: 6px 10px;
        font-size: 1em;
        border-radius: 4px;
        cursor: pointer;
    }
</style>
